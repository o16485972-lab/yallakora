# انسخ هذا الملف إلى .env داخل مجلد functions قبل النشر
# مفتاح OpenAI اختياري — بدونه يعمل aiBrief بالملخص المحلي
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# سر اختياري لحماية sendPush و aiBrief (أرسل الهيدر x-kora-secret)
KORA_PUSH_SECRET=

# لا تضع مفاتيح Firebase الإدارية هنا — firebase-admin يستخدم بيانات المشروع تلقائياً
# على الجهاز المحلي: gcloud auth application-default login
# أو: $env:GOOGLE_APPLICATION_CREDENTIALS="C:\path\serviceAccount.json"
